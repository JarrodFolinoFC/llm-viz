{
  "name": "llm-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "tsc -b && vite build --base=/llm-training/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tools:probe": "node scripts/probe.mjs",
    "tools:smoke": "node scripts/smoke.mjs",
    "tools:list-files": "node -e \"const fs = require('fs'); const walk = dir => fs.readdirSync(dir, { withFileTypes: true }).forEach(f => { const p = require('path').join(dir, f.name); if (f.isDirectory() && f.name !== 'node_modules') walk(p); else if (f.isFile() && /\\.(jsx|tsx)$/.test(f.name)) console.log(p); }); walk('.');\"",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "chrono-node": "^2.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "katex": "^0.16.10",
    "mermaid": "^11.16.0",
    "plotly.js-gl3d-dist-min": "^3.6.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-plotly.js": "^4.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.6.0",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-onboarding": "^10.4.5",
    "@storybook/addon-vitest": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.0.0",
    "@types/plotly.js": "^3.0.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.8",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.61.0",
    "storybook": "^10.4.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
