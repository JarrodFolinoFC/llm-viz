{
  "compilerOptions": {
    "composite": true,
    // A referenced composite project may not set noEmit (TS6310). The problem
    // we're actually avoiding is `tsc -b` writing vite.config.js next to the
    // sources, where Vite loads it ahead of vite.config.ts and silently shadows
    // this config (base path, ports) at runtime. So emit declarations only and
    // send all output to a temp dir under node_modules instead of disabling it.
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
